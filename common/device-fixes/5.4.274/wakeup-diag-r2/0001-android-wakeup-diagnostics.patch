+/* Snapshot pending sources under their existing SRCU lifetime protection.
+ * This records observations, not a claim that the last active source caused
+ * the abort. Always pass text as data, never as a printf format string.
+ */
+static void pm_log_pending_wakeup(void)
+{
+	struct wakeup_source *ws, *last = NULL;
+	char reason[MAX_SUSPEND_ABORT_LEN] = "Pending wakeup (source unavailable)";
+	int idx, len = 0;
+
+	idx = srcu_read_lock(&wakeup_srcu);
+	list_for_each_entry_rcu(ws, &wakeup_sources, entry) {
+		if (ws->active) {
+			if (!len)
+				len = scnprintf(reason, sizeof(reason),
+						"Pending wakeup sources: ");
+			len += scnprintf(reason + len, sizeof(reason) - len,
+					 "%s ", ws->name);
+		} else if (!last || ktime_to_ns(ws->last_time) >
+				   ktime_to_ns(last->last_time)) {
+			last = ws;
+		}
+	}
+	if (!len && last)
+		scnprintf(reason, sizeof(reason),
+			  "Wakeup pending; last active source: %s", last->name);
+	srcu_read_unlock(&wakeup_srcu, idx);
+	log_suspend_abort_reason("%s", reason);
+}
