 /************************
  * USB PSY REGISTRATION *
  ************************/
+/* USB_TYPE uses its own enum; do not expose power_supply_type values here. */
+static int wt_get_usb_type(struct batt_chg *chg, int *usb_type)
+{
+	int rc, type, pd_active;
+
+	*usb_type = POWER_SUPPLY_USB_TYPE_UNKNOWN;
+	/* Reporting this property must not run get_real_type()'s charging policy. */
+	if (READ_ONCE(chg->otg_enable) || READ_ONCE(chg->mishow_flag) ||
+	    READ_ONCE(chg->vbus_cnt) > 3)
+		return 0;
+
+	pd_active = READ_ONCE(chg->pd_active);
+	if (pd_active == QTI_POWER_SUPPLY_PD_PPS_ACTIVE) {
+		*usb_type = POWER_SUPPLY_USB_TYPE_PD_PPS;
+		return 0;
+	}
+	if (pd_active == QTI_POWER_SUPPLY_PD_ACTIVE) {
+		*usb_type = POWER_SUPPLY_USB_TYPE_PD;
+		return 0;
+	}
+
+	rc = batt_get_iio_channel(chg, MAIN, MAIN_CHARGER_TYPE, &type);
+	if (rc < 0)
+		return rc;
+
+	switch (type) {
+	case POWER_SUPPLY_TYPE_USB:
+		*usb_type = POWER_SUPPLY_USB_TYPE_SDP;
+		break;
+	case POWER_SUPPLY_TYPE_USB_DCP:
+	case POWER_SUPPLY_TYPE_USB_HVDCP:
+	case POWER_SUPPLY_TYPE_USB_HVDCP_3:
+	case POWER_SUPPLY_TYPE_USB_HVDCP_3P5:
+		/* The standard USB_TYPE enum has no Quick Charge subtype. */
+		*usb_type = POWER_SUPPLY_USB_TYPE_DCP;
+		break;
+	case POWER_SUPPLY_TYPE_USB_CDP:
+		*usb_type = POWER_SUPPLY_USB_TYPE_CDP;
+		break;
+	case POWER_SUPPLY_TYPE_USB_ACA:
+		*usb_type = POWER_SUPPLY_USB_TYPE_ACA;
+		break;
+	case POWER_SUPPLY_TYPE_USB_TYPE_C:
+		*usb_type = POWER_SUPPLY_USB_TYPE_C;
+		break;
+	case POWER_SUPPLY_TYPE_USB_PD:
+		*usb_type = POWER_SUPPLY_USB_TYPE_PD;
+		break;
+	case POWER_SUPPLY_TYPE_USB_PD_DRP:
+		*usb_type = POWER_SUPPLY_USB_TYPE_PD_DRP;
+		break;
+	case POWER_SUPPLY_TYPE_APPLE_BRICK_ID:
+		*usb_type = POWER_SUPPLY_USB_TYPE_APPLE_BRICK_ID;
+		break;
+	default:
+		/* Unknown and floating sources must not be advertised as SDP. */
+		break;
+	}
+
+	return 0;
+}
