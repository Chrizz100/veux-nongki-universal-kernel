+/* Optional CP telemetry must not stop charging work after an ADC error. */
+static void batt_update_cp_temperatures(struct batt_chg *chg)
+{
+	int rc, temp;
+
+	rc = get_charger_pump_master_temp(chg, &temp);
+	if (rc < 0) {
+		pr_err_ratelimited("cp_master_temp unavailable, rc=%d\n", rc);
+	} else {
+		WRITE_ONCE(chg->cp_master_temp, temp);
+		pr_debug("cp_master_temp %d\n", temp);
+	}
+
+	rc = get_charger_pump_slave_temp(chg, &temp);
+	if (rc < 0) {
+		pr_err_ratelimited("cp_slave_temp unavailable, rc=%d\n", rc);
+	} else {
+		WRITE_ONCE(chg->cp_slave_temp, temp);
+		pr_debug("cp_slave_temp %d\n", temp);
+	}
+}
