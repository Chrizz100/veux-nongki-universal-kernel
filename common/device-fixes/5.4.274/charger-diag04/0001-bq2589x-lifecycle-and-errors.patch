+/* Match the 5 V threshold already used when an adapter is disconnected. */
+#define BQ2589X_5V_VINDPM_MV 4400
+
+static bool bq2589x_is_5v_input(int vbus)
+{
+	return vbus >= 4800 && vbus <= 5500;
+}
+
 int bq2589x_set_input_volt_limit(struct bq2589x *bq, int volt)
 {
+	int vbus;
 	u8 val;
+
+	/* A cached MAXC classification can outlive the negotiated 9 V supply. */
+	if (volt > 5500 && bq->cfg.enable_term && !bq->cfg.otg_status) {
+		vbus = bq2589x_adc_read_vbus_volt(bq);
+		if (vbus < 0)
+			return vbus;
+		if (bq2589x_is_5v_input(vbus))
+			volt = BQ2589X_5V_VINDPM_MV;
+	}
 	val = (volt - BQ2589X_VINDPM_BASE) / BQ2589X_VINDPM_LSB;
 	return bq2589x_update_bits(bq, BQ2589X_REG_0D, BQ2589X_VINDPM_MASK, val << BQ2589X_VINDPM_SHIFT);
+}
+
+static int bq2589x_restore_5v_vindpm(struct bq2589x *bq)
+{
+	int vbus, vindpm, ret;
+	u8 reg;
+
+	/* Termination is disabled while the charge pump owns the charging path. */
+	if (!bq->cfg.enable_term || bq->cfg.otg_status)
+		return 0;
+	vbus = bq2589x_adc_read_vbus_volt(bq);
+	if (vbus < 0)
+		return vbus;
+	if (!bq2589x_is_5v_input(vbus))
+		return 0;
+	ret = bq2589x_read_byte(bq, &reg, BQ2589X_REG_0D);
+	if (ret < 0)
+		return ret;
+	/* Do not override the chip's relative VINDPM algorithm. */
+	if (!(reg & BQ2589X_FORCE_VINDPM_MASK))
+		return 0;
+	vindpm = BQ2589X_VINDPM_BASE +
+		((reg & BQ2589X_VINDPM_MASK) >> BQ2589X_VINDPM_SHIFT) *
+		BQ2589X_VINDPM_LSB;
+	if (vindpm <= vbus)
+		return 0;
+	ret = bq2589x_set_input_volt_limit(bq, BQ2589X_5V_VINDPM_MV);
+	if (ret < 0)
+		return ret;
+	ret = bq2589x_read_vindpm_volt(bq);
+	if (ret < 0)
+		return ret;
+	if (ret != BQ2589X_5V_VINDPM_MV)
+		return -EIO;
+	dev_info(bq->dev, "%s: VBUS %d mV, VINDPM %d -> %d mV\n",
+		 __func__, vbus, vindpm, ret);
+	return 0;
 }
 
