+static int bq_iio_write_raw_unlocked(struct iio_dev *indio_dev,
+		struct iio_chan_spec const *chan, int val1,
+		int val2, long mask)
+{
+	struct bq2589x *bq = iio_priv(indio_dev);
+	int rc = 0;
+	union power_supply_propval val = {0,};
+
+	switch (chan->channel) {
+	case PSY_IIO_MAIN_CHAGER_HZ:
+		if (val1 > 0) {
+			rc = bq2589x_enter_hiz_mode(bq);
+			if (!rc)
+				bq->hz_flag = false;
+		} else {
+			rc = bq2589x_exit_hiz_mode(bq);
+			if (rc < 0)
+				break;
+			bq->usb_switch_flag = false;
+			bq->hz_flag = val1 == 0 && bq->is_bq25890h;
+		}
+		break;
+	case PSY_IIO_MAIN_INPUT_CURRENT_SETTLED:
+		if (val1 >= 3100)
+			val1 = 3100;
+		rc = bq2589x_update_bits(bq, BQ2589X_REG_00, BQ2589X_ENILIM_MASK,
+			BQ2589X_ENILIM_DISABLE << BQ2589X_ENILIM_SHIFT);
+		if (!rc)
+			rc = bq2589x_set_input_current_limit(bq, val1);
+		break;
+	case PSY_IIO_MAIN_INPUT_VOLTAGE_SETTLED:
+		rc = bq2589x_set_input_volt_limit(bq, val1);
+		break;
+	case PSY_IIO_MAIN_CHAGER_CURRENT:
+		if (val1 >= 3100)
+			val1 = 3100;
+		rc = bq2589x_set_charge_current(bq, val1);
+		if (rc < 0)
+			break;
+		bq->cfg.input_current = val1;
+		if (val1 == 100)
+			rc = bq2589x_set_chargevoltage(bq, 4608);
+		break;
+	case PSY_IIO_CHARGING_ENABLED:
+		rc = val1 ? bq2589x_enable_charger(bq) : bq2589x_disable_charger(bq);
+		break;
+	case PSY_IIO_OTG_ENABLE:
+		rc = gpio_direction_output(bq->otg_gpio, val1);
+		if (rc < 0)
+			break;
+		if (val1) {
+			bq2589x_usb_switch(bq, !val1);
+			rc = bq2589x_exit_hiz_mode(bq);
+			if (rc < 0)
+				break;
+			rc = bq2589x_disable_charger(bq);
+			if (rc < 0)
+				break;
+			rc = bq2589x_enable_otg(bq);
+			if (rc < 0)
+				break;
+			bq->cfg.otg_status = true;
+			if (!bq->wakeup_flag) {
+				__pm_stay_awake(bq->wt_ws);
+				bq->wakeup_flag = 1;
+			}
+			rc = bq2589x_set_otg_volt(bq, 5300);
+			if (rc < 0)
+				break;
+			if (bq->batt_psy) {
+				rc = power_supply_get_property(bq->batt_psy,
+					POWER_SUPPLY_PROP_CAPACITY, &val);
+				if (rc < 0)
+					break;
+			}
+			rc = bq2589x_set_otg_current(bq, val.intval > 5 ? 1800 : 1500);
+		} else {
+			rc = bq2589x_disable_otg(bq);
+			if (rc < 0)
+				break;
+			bq->cfg.otg_status = false;
+			if (bq->wakeup_flag) {
+				__pm_relax(bq->wt_ws);
+				bq->wakeup_flag = 0;
+			}
+			rc = bq2589x_enable_charger(bq);
+		}
+		break;
+	case PSY_IIO_MAIN_CHAGER_TERM:
+		if (bq->batt_psy) {
+			rc = power_supply_get_property(bq->batt_psy,
+				POWER_SUPPLY_PROP_TEMP, &val);
+			if (rc < 0)
+				break;
+		}
+		if (bq->is_bq25890h && val.intval >= 100)
+			val1 -= 64;
+		rc = bq2589x_set_term_current(bq, val1);
+		break;
+	case PSY_IIO_BATTERY_VOLTAGE_TERM:
+		rc = bq2589x_set_chargevoltage(bq, val1);
+		break;
+	case PSY_IIO_ENABLE_CHAGER_TERM:
+		rc = bq2589x_enable_term(bq, !!val1);
+		if (rc < 0)
+			break;
+		bq->cfg.enable_term = !!val1;
+		if (val1)
+			rc = bq2589x_restore_5v_vindpm(bq);
+		break;
+	default:
+		rc = -EINVAL;
+		break;
+	}
+
+	if (rc < 0)
+		pr_err_ratelimited("Couldn't write IIO channel %d, rc = %d\n",
+			chan->channel, rc);
+	return rc;
+}
