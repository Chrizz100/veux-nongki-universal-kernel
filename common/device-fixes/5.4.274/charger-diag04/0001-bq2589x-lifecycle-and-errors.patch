+static int bq_iio_read_raw(struct iio_dev *indio_dev,
+		struct iio_chan_spec const *chan, int *val1,
+		int *val2, long mask)
+{
+	struct bq2589x *bq = iio_priv(indio_dev);
+	int ret;
+
+	mutex_lock(&bq->io_lock);
+	ret = bq->stopping ? -ESHUTDOWN :
+		bq_iio_read_raw_unlocked(indio_dev, chan, val1, val2, mask);
+	mutex_unlock(&bq->io_lock);
+	return ret;
 }
 
