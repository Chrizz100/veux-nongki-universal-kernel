name: VEUX R55C2-R2 SUSFS 5.4 ProcFS readlink corrected Git postimage - NO BUILD NO FLASH
'on':
  workflow_dispatch: {}
permissions:
  contents: read
jobs:
  r55c2_source:
    if: ${{ github.repository == 'Chrizz100/veux-nongki-universal-kernel' && github.ref == 'refs/heads/main' }}
    runs-on: ubuntu-24.04
    timeout-minutes: 35
    env:
      R55_STAGE: /tmp/veux-r55c2
      PYTHONDONTWRITEBYTECODE: '1'
    steps:
    - name: Read-only project checkout
      uses: actions/checkout@11bd71901bbe5b1630ceea73d27597364c9af683
      with:
        path: project
        persist-credentials: false
        fetch-depth: 1
    - name: Detached pinned Xiaomi 5.4.274 source
      uses: actions/checkout@11bd71901bbe5b1630ceea73d27597364c9af683
      with:
        path: kernel
        repository: dereference23/kernel_xiaomi_sm6375
        ref: b2b7a3bbc36d120ee523ebc8d68e0f13a97df632
        persist-credentials: false
        fetch-depth: 1
    - name: Restore SHA-pinned R55C1 input source tests and original SUSFS helper
