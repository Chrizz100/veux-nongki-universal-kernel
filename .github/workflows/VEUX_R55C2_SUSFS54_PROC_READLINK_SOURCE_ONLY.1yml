        Sg1J4Wj1/wNQ49StNBQBAA==
        """),
        }
        for name,(digest,encoded) in items.items():
            data=gzip.decompress(base64.b64decode(''.join(encoded.split())))
            if hashlib.sha256(data).hexdigest()!=digest:raise SystemExit('R55C2_EMBEDDED_SHA256_MISMATCH:'+name)
            path=stage/name;path.parent.mkdir(parents=True,exist_ok=True);path.write_bytes(data)
            print('R55C2_EMBEDDED_ASSET_VERIFIED',name,len(data),digest)
        PY_R55C2_RESTORE
    - name: Strict actionlint duplicate-YAML-keys ShellCheck and pin gates
      run: |
        set -euo pipefail
        archive='project/VEUX_R39_R2_MEMORY_ABI_MAIN.zip'
        printf '%s  %s\n' '745d80b8502a9beea513a2e7a58bb59272539b7508920d235ce2e79741bda528' "$archive" | sha256sum -c -
        unzip -p "$archive" tools/actionlint > "$R55_STAGE/actionlint"
        chmod 0755 "$R55_STAGE/actionlint"
        "$R55_STAGE/actionlint" -version | grep -Fx '1.7.12'
        "$R55_STAGE/actionlint" -color=false -shellcheck='' 'project/.github/workflows/VEUX_R55C2_SUSFS54_PROC_READLINK_SOURCE_ONLY.yml' > "$R55_STAGE/R55C2_ACTIONLINT.log"
        printf 'R55C2_ACTIONLINT_1_7_12=PASS\n' >> "$R55_STAGE/R55C2_ACTIONLINT.log"
        python3 -B - <<'PY_R55C2_YAML_AUDIT'
        import pathlib,hashlib,subprocess,yaml
        class Strict(yaml.SafeLoader): pass
        def mapping(loader,node):
            result={}
            for kn,vn in node.value:
                key=loader.construct_object(kn)
                if key in result:raise RuntimeError('DUPLICATE_YAML_KEY:'+str(key))
                result[key]=loader.construct_object(vn)
            return result
        Strict.add_constructor(yaml.resolver.BaseResolver.DEFAULT_MAPPING_TAG,mapping)
        w=yaml.load(pathlib.Path('project/.github/workflows/VEUX_R55C2_SUSFS54_PROC_READLINK_SOURCE_ONLY.yml').read_text('utf-8'),Loader=Strict)
        assert list(w['on'])==['workflow_dispatch']
        assert w['permissions']=={'contents':'read'}
        assert set(w['jobs'])=={'r55c2_source'}
        j=w['jobs']['r55c2_source'];s=j['steps']
        assert j['runs-on']=='ubuntu-24.04'
        assert 'github.repository' in j['if'] and 'refs/heads/main' in j['if']
        assert len(s)==9
        for i in (0,1):
            assert s[i]['uses']=='actions/checkout@11bd71901bbe5b1630ceea73d27597364c9af683'
            assert s[i]['with']['persist-credentials'] is False
        assert s[1]['with']['repository']=='dereference23/kernel_xiaomi_sm6375'
        assert s[1]['with']['ref']=='b2b7a3bbc36d120ee523ebc8d68e0f13a97df632'
        assert s[8]['uses']=='actions/upload-artifact@ea165f8d65b6e75b540449e92b4886f43607fa02'
        assert s[8]['with']['if-no-files-found']=='error'
        logs=[]
        for step in s:
            if 'run' not in step:continue
            body=step['run']
            if chr(36)+chr(123) in body:raise RuntimeError('GITHUB_EXPRESSION_IN_RUN_BLOCK')
            for cmd in (['bash','-n','-'],['shellcheck','--shell=bash','--severity=warning','-']):
                q=subprocess.run(cmd,input=body,text=True,capture_output=True)
                if q.returncode:raise RuntimeError('SCRIPT_SHELL_ERROR:'+step['name']+':'+q.stdout+q.stderr)
            logs.append(step['name']+' BASH_SHELLCHECK_PASS SHA256='+hashlib.sha256(body.encode()).hexdigest())
        pathlib.Path('/tmp/veux-r55c2/R55C2_SHELLCHECK.log').write_text('\n'.join(logs)+'\n')
        print('R55C2_YAML_DUP_KEYS_ACTION_INPUTS_ALL_SHELLS=PASS')
        PY_R55C2_YAML_AUDIT
    - name: 33 positive, negative, real Git postimage and C harness tests
      run: |
        set -euo pipefail
        python3 -B - <<'PY_R55C2_AST'
        import ast,pathlib
        stage=pathlib.Path('/tmp/veux-r55c2')
        for name in ('scripts/r55c2_proc_readlink.py','tests/test_r55c2_proc_readlink.py','tests/test_r55c2_postimage_pin.py'):
            ast.parse((stage/name).read_text('utf-8'))
        print('R55C2_R2_PYTHON_AST=PASS')
        PY_R55C2_AST
        python3 -B -m unittest discover -v -s "$R55_STAGE/tests" -p 'test_*.py' 2>&1 | tee "$R55_STAGE/R55C2_TESTS.log"
        grep -Eq '^Ran 33 tests in [0-9.]+s$' "$R55_STAGE/R55C2_TESTS.log"
        grep -Fx 'OK' "$R55_STAGE/R55C2_TESTS.log"
        echo 'R55C2_R2_33_REAL_GIT_POSTIMAGE_C_AND_SOURCE_TESTS=PASS'
    - name: Replay R55C1 and port two real ProcFS readlink source files
      run: |
        set -euo pipefail
        python3 -B "$R55_STAGE/scripts/r55c2_proc_readlink.py"   --source kernel --base "$R55_STAGE/inputs/R55C1_AUTHENTIC_16FILES.patch"   --out "$R55_STAGE/out" 2>&1 | tee "$R55_STAGE/R55C2_REAL_SOURCE.log"
        python3 -B - <<'PY_R55C2_POSTCHECK'
        import pathlib,hashlib,json
        out=pathlib.Path('/tmp/veux-r55c2/out')
        r=json.loads((out/'R55C2_RESULT.json').read_text('utf-8'))
        assert r['files_total']==16 and r['proc_readlink_integrated'] is True
        assert r['kernel_compiled'] is False and r['flash_allowed'] is False
        assert r['r55c1_input_sha256']=='87af9157b3aad0eb62894515e9b7ad16633a299e59f7de1b66e3c41604b26cf3'
        p=out/'VEUX_R55C2_SUSFS54_16_FILES_PROC_READLINK_NOFLASH.patch'
        assert hashlib.sha256(p.read_bytes()).hexdigest()==r['complete_16_file_patch_sha256']
        print('R55C2_REAL_SOURCE_POSTCHECK=PASS')
        PY_R55C2_POSTCHECK
    - name: Independent clean 16-file exact byte Git replay
      run: |
        set -euo pipefail
        git -C kernel worktree add --detach "$R55_STAGE/replay" b2b7a3bbc36d120ee523ebc8d68e0f13a97df632
        total="$R55_STAGE/out/VEUX_R55C2_SUSFS54_16_FILES_PROC_READLINK_NOFLASH.patch"
        git -C "$R55_STAGE/replay" apply --check --whitespace=error "$total"
        git -C "$R55_STAGE/replay" apply --whitespace=error "$total"
        # Include the 3 legitimate new SUSFS source files in git diff without committing.
        git -C "$R55_STAGE/replay" add -N -- fs/susfs.c include/linux/susfs.h include/linux/susfs_def.h
        git -C "$R55_STAGE/replay" diff --check
        python3 -B - <<'PY_R55C2_REPLAY'
        import pathlib,hashlib,subprocess,json,sys
        root=pathlib.Path('/tmp/veux-r55c2');kernel=pathlib.Path('kernel');replay=root/'replay';out=root/'out'
        sys.path.insert(0,str(root/'scripts'))
        import r55c2_proc_readlink as p
        changed=set(subprocess.run(['git','-C',str(replay),'diff','--name-only'],capture_output=True,text=True,check=True).stdout.splitlines())
        assert changed==p.EXISTING,('BAD_16_FILE_SCOPE',sorted(changed^p.EXISTING))
        for name in sorted(p.EXISTING):
            assert hashlib.sha256((kernel/name).read_bytes()).digest()==hashlib.sha256((replay/name).read_bytes()).digest(),name
        actual=subprocess.run(['git','-C',str(replay),'diff','--binary','--no-ext-diff'],capture_output=True,check=True).stdout
        assert actual==(out/p.TOTAL_NAME).read_bytes()
        r=json.loads((out/p.RESULT_NAME).read_text())
        assert r['proc_readlink_integrated'] and not r['boot_ready'] and not r['flash_allowed']
        r['source_replay_verified']=True
        (out/p.RESULT_NAME).write_text(json.dumps(r,indent=2,sort_keys=True)+'\n')
        print('R55C2_REAL_16_FILES_EXACT_GIT_REPLAY=PASS')
        PY_R55C2_REPLAY
    - name: Final source scope SHA256 and NOFLASH gates
      run: |
        set -euo pipefail
        cp "$R55_STAGE/R55C2_ACTIONLINT.log" "$R55_STAGE/R55C2_SHELLCHECK.log"    "$R55_STAGE/R55C2_TESTS.log" "$R55_STAGE/R55C2_REAL_SOURCE.log" "$R55_STAGE/out/"
        python3 -B - <<'PY_R55C2_FINAL'
        import pathlib,hashlib,json
        out=pathlib.Path('/tmp/veux-r55c2/out')
        r=json.loads((out/'R55C2_RESULT.json').read_text())
        assert r['source_replay_verified'] and r['files_total']==16 and r['proc_readlink_integrated']
        for flag in ('kernel_compiled','proc_readlink_runtime_validated','full_susfs_port',
                     'baka_su_uapi6_integrated','nomount_v22_integrated',
                     'runtime_semantics_review_complete','device_tested',
                     'brene_changed','vendor_changed','boot_ready','flash_allowed','user_repo_modified'):
            assert r[flag] is False,flag
        files=sorted(p for p in out.iterdir() if p.is_file() and p.name!='SHA256SUMS.txt')
        assert len(files)==8,len(files)
        (out/'SHA256SUMS.txt').write_text(''.join(
            hashlib.sha256(p.read_bytes()).hexdigest()+'  '+p.name+'\n' for p in files))
        print('R55C2_SOURCE_ONLY_FINAL_SHA256_NOFLASH=PASS')
        PY_R55C2_FINAL
        (cd "$R55_STAGE/out" && sha256sum -c SHA256SUMS.txt)
        test -z "$(git -C project status --porcelain --untracked-files=all)"
        echo 'R55C2_PROJECT_REPO_UNMODIFIED; NO_COMPILE; NO_FLASH'
    - name: Upload R55C2 source patches and audit proofs ONLY
      uses: actions/upload-artifact@ea165f8d65b6e75b540449e92b4886f43607fa02
      with:
        name: VEUX-R55C2-R2-PROC-READLINK-16FILES-NOFLASH-${{ github.run_id }}
        path: /tmp/veux-r55c2/out/
        retention-days: 14
        if-no-files-found: error
